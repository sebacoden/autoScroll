<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Manifest del source set `debug/`. Se fusiona sobre el manifest principal SOLO en
      builds debug. Acá registramos el receptor de control por `adb` para probar el
      toggle del auto-scroll sin depender de la detección de gestos del emulador.
      `tools:ignore="ExportedReceiver"` porque la exposición es intencional: lo
      consumimos solo desde la línea de comandos del dev.
    -->
    <application>
        <receiver
            android:name=".debug.DebugToggleReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.freelanzer.autoscroller.debug.TOGGLE" />
                <action android:name="com.freelanzer.autoscroller.debug.START" />
                <action android:name="com.freelanzer.autoscroller.debug.STOP" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
